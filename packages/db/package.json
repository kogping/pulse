{
  "name": "@pulse/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate-freshness-sql": "tsx scripts/generate-freshness-sql.ts",
    "db:seed": "tsx scripts/seed.ts",
    "check:destructive-migrations": "tsx scripts/check-destructive-migrations.ts",
    "check:no-direct-attribute-import": "tsx scripts/check-no-direct-attribute-import.ts"
  },
  "devDependencies": {
    "@pulse/config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "fast-check": "^4.9.0",
    "tsx": "^4.23.5",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@upstash/redis": "^1.38.1",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  }
}
